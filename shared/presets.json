{
  "$comment": "Single source of truth for material presets, lighting presets, platforms, appearances and render quality tiers. Read by the web UI (sliders/labels) and the Blender worker (defaults). Param keys are camelCase. 'paint' = the SVG art colour of the layer (texture or fill override) and how each preset consumes it.",
  "version": 1,
  "materials": {
    "liquid_glass": {
      "label": "Liquid Glass",
      "category": "Glass",
      "description": "Apple-style Liquid Glass: thick pill-edged glass with a crisp wet coat, light-locked rim highlights, frost and soft shadows.",
      "paint": "tint",
      "engines": {
        "cycles": "full",
        "eevee": "good"
      },
      "params": {
        "tint": {
          "label": "Tint",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 1.0,
          "help": "How strongly the layer colour tints the glass (1 = the exact SVG colour)."
        },
        "frost": {
          "label": "Frost / Blur",
          "type": "number",
          "min": 0,
          "max": 0.5,
          "step": 0.01,
          "default": 0.06,
          "help": "Surface roughness of the transmission (Icon Composer 'Blur')."
        },
        "translucency": {
          "label": "Translucency",
          "type": "number",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.75,
          "help": "How see-through the glass is (Icon Composer 'Translucency')."
        },
        "ior": {
          "label": "Refraction",
          "type": "number",
          "min": 1.0,
          "max": 1.8,
          "step": 0.01,
          "default": 1.5,
          "unit": "IOR",
          "help": "Index of refraction — lensing strength at the rounded edges."
        },
        "specular": {
          "label": "Specular",
          "type": "enum",
          "options": [
            "off",
            "auto",
            "inside",
            "outside"
          ],
          "default": "auto",
          "help": "Edge highlight placement (Icon Composer 2.0)."
        },
        "rim": {
          "label": "Rim Highlight",
          "type": "number",
          "min": 0,
          "max": 3,
          "step": 0.05,
          "default": 1.0,
          "help": "Light-angle-locked rim emission strength."
        },
        "glow": {
          "label": "Inner Glow",
          "type": "number",
          "min": 0,
          "max": 2,
          "step": 0.05,
          "default": 0.35,
          "help": "Lit-from-within glow near the edges."
        }
      }
    },
